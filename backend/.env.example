# ──────────────────────────────────────────────
# Backend Django — Variables de entorno
# Copiar a .env y completar valores reales
# ──────────────────────────────────────────────

# Django
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL en prod, SQLite para local)
# Formato: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=sqlite:///db.sqlite3

# CORS — origins adicionales (comma-separated)
# En producción: la URL del frontend desplegado
FRONT_ORIGINS=http://localhost:3000,http://localhost:5173

# Puerto del servidor (usado por gunicorn en producción)
PORT=8080

# Django settings module
DJANGO_SETTINGS_MODULE=config.settings.local

# Logging
LOG_LEVEL=INFO
